# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/license-platform

# JWT
JWT_SECRET=changez-moi-en-production-avec-une-cle-longue-et-aleatoire
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# License signing (RSA keys - generate with npm run generate-keys)
LICENSE_PRIVATE_KEY_PATH=./keys/license-private.pem
LICENSE_PUBLIC_KEY_PATH=./keys/license-public.pem

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# License verification interval (days) - info returned to clients
LICENSE_CHECK_INTERVAL_DAYS=30

# Initial super admin (used by seed script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
