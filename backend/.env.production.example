# Production — licenceskayapps.duckdns.org (IP: 196.178.221.197)

NODE_ENV=production
PORT=4000
API_BASE_URL=https://licenceskayapps.duckdns.org

# MongoDB (local sur le VPS ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/license-platform

# JWT — générez une clé forte : openssl rand -base64 48
JWT_SECRET=REMPLACEZ-PAR-UNE-CLE-ALEATOIRE-LONGUE
JWT_EXPIRES_IN=8h

LICENSE_PRIVATE_KEY_PATH=./keys/license-private.pem
LICENSE_PUBLIC_KEY_PATH=./keys/license-public.pem

CORS_ORIGIN=https://licenceskayapps.duckdns.org

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LICENSE_CHECK_INTERVAL_DAYS=30

# Changez impérativement avant le premier seed en production
SEED_ADMIN_EMAIL=kaycerkhouini99@gmail.com
SEED_ADMIN_PASSWORD=Its goddamn kay123!
